# ============================================================
# Sargam backend configuration
# Copy this file to `.env` and fill in what you have.
# The app runs fine with NOTHING set — it uses the curated
# catalog + live JioSaavn streaming (no keys required).
# ============================================================

# --- Spotify (optional) --------------------------------------
# Create a free app at https://developer.spotify.com/dashboard
# When set, the "Brain" does real acoustic-feature matching.
#SPOTIFY_CLIENT_ID=your_client_id
#SPOTIFY_CLIENT_SECRET=your_client_secret

# --- MongoDB (optional) --------------------------------------
# When unset, history & liked songs are stored in backend/data/store/*.json
#MONGO_URI=mongodb://localhost:27017
#MONGO_DB=sargam

# --- Server ---------------------------------------------------
PORT=5000
HOST=127.0.0.1

# --- Behavior -------------------------------------------------
# 1  = fall back to curated catalog when a live JioSaavn lookup fails
# 0  = return the error to the client instead
CATALOG_FALLBACK=1

# Number of seconds a resolved JioSaavn stream URL stays cached
STREAM_CACHE_TTL=3600
